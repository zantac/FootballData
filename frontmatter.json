{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.content.supportedFileTypes": [
    "json"
  ],
  "frontMatter.data.files": [
    {
      "id": "competitionsData",
      "fileType": "json",
      "contentType": "competition",
      "path": "[[workspace]]/**/!(*.schema|frontmatter).json"
    }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "id": "competition",
      "name": "Competition",
      "pageBundle": false,
      "fields": [
        {
          "title": "Matches",
          "name": "matches",
          "type": "list",
          "fields": [
            {
              "title": "Match Details",
              "name": "match_details",
              "type": "block",
              "fields": [
                { "title": "Match ID", "name": "match_id", "type": "string" },
                { "title": "Group", "name": "group", "type": "string" },
                { "title": "Week", "name": "week", "type": "string" },
                { "title": "Date", "name": "date", "type": "datetime", "isMeridiem": false },
                { "title": "Time", "name": "time", "type": "string" },
                { "title": "Home Team ID", "name": "home_team_id", "type": "string" },
                { "title": "Away Team ID", "name": "away_team_id", "type": "string" },
                { "title": "Venue", "name": "venue", "type": "string" },
                { "title": "Status", "name": "status", "type": "choice", "choices": ["completed", "upcoming"] },
                { "title": "Note", "name": "note", "type": "string" },
                { "title": "Home Squad", "name": "home_squade", "type": "list" },
                { "title": "Away Squad", "name": "away_squade", "type": "list" },
                { "title": "Home Score", "name": "home_score", "type": "number" },
                { "title": "Away Score", "name": "away_score", "type": "number" },
                { "title": "Home Scorers", "name": "home_scorers", "type": "list" },
                { "title": "Away Scorers", "name": "away_scorers", "type": "list" }
              ]
            }
          ]
        },
        {
          "title": "Standings",
          "name": "standings",
          "type": "list",
          "fields": [
            {
              "title": "Standing Entry",
              "name": "standing_entry",
              "type": "block",
              "fields": [
                { "title": "Team ID", "name": "team_id", "type": "string" },
                { "title": "Position", "name": "position", "type": "number" },
                { "title": "Points", "name": "points", "type": "number" },
                { "title": "Matches Played", "name": "matches_played", "type": "number" },
                { "title": "Wins", "name": "wins", "type": "number" },
                { "title": "Draws", "name": "draws", "type": "number" },
                { "title": "Losses", "name": "losses", "type": "number" },
                { "title": "Goals For", "name": "goals_for", "type": "number" },
                { "title": "Goals Against", "name": "goals_against", "type": "number" }
              ]
            }
          ]
        },
        {
          "title": "Teams",
          "name": "teams",
          "type": "list",
          "fields": [
            {
              "title": "Team Details",
              "name": "team_details",
              "type": "block",
              "fields": [
                { "title": "Team ID", "name": "team_id", "type": "string" },
                { "title": "Team Name", "name": "name", "type": "string" },
                { "title": "Logo URL", "name": "logo", "type": "string" },
                {
                  "title": "Players",
                  "name": "players",
                  "type": "fieldGroup",
                  "fields": [
                    { "title": "Coach", "name": "coach", "type": "list" },
                    { "title": "Goalkeepers", "name": "goalkeepers", "type": "list" },
                    { "title": "Defenders", "name": "defenders", "type": "list" },
                    { "title": "Midfielders", "name": "midfielders", "type": "list" },
                    { "title": "Attackers", "name": "attackers", "type": "list" }
                  ]
                }
              ]
            }
          ]
        },
        { "title": "Scorers", "name": "scorrers", "type": "string" },
        { "title": "Assists", "name": "assists", "type": "string" },
        { "title": "Cleansheets", "name": "cleansheets", "type": "string" },
        { "title": "Penalty Blocks", "name": "penalityblocks", "type": "string" }
      ]
    }
  ],
  "frontMatter.content.pageFolders": [
    { "title": "Competition 2005", "path": "[[workspace]]/2005" },
    { "title": "Competition 2007", "path": "[[workspace]]/2007" },
    { "title": "Competition 2008", "path": "[[workspace]]/2008" },
    { "title": "Competition 2009", "path": "[[workspace]]/2009" },
    { "title": "Competition 2010", "path": "[[workspace]]/2010" },
    { "title": "Competition 2011", "path": "[[workspace]]/2011" }
  ]
}